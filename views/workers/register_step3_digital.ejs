
<%- include('../partials/header', { title: 'Sertifikat Digital' }) %>
<div class="card" style="max-width:820px; margin:0 auto;">
  <h2>Upload Sertifikat (Digital)</h2>
  <form method="post" action="/workers/register/step3/digital">
    <label>Penerbit (Issuer)</label>
    <input type="text" name="issuer" placeholder="Dicoding / Google / AWS / Unity / Autodesk / Adobe / Coursera" required />
    <label>Nama Sertifikat</label>
    <input type="text" name="cert_name" required />
    <label>ID Sertifikat (opsional)</label>
    <input type="text" name="cert_id" />
    <label>URL Verifikasi (opsional)</label>
    <input type="url" name="verify_url" />
    <label>Tanggal Terbit</label>
    <input type="date" name="issued_at" />
    <label>Tanggal Kadaluwarsa (opsional)</label>
    <input type="date" name="expires_at" />
    <button class="btn primary" type="submit">Tambah Sertifikat</button>
  </form>
  <h3>Sertifikat Anda</h3>
  <table class="table">
    <tr><th>Issuer</th><th>Nama</th><th>ID</th><th>Status</th></tr>
    <% (certs || []).forEach(c => { %>
      <tr>
        <td><%= c.issuer %></td>
        <td><%= c.cert_name %></td>
        <td><%= c.cert_id || '-' %></td>
        <td><span class="badge"><%= c.status %></span></td>
      </tr>
    <% }) %>
  </table>
  <p><small class="muted">Admin akan memverifikasi sertifikat Anda.</small></p>
</div>
<%- include('../partials/footer') %>
