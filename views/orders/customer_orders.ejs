
<%- include('../partials/header', { title: 'Order Saya (Customer)' }) %>
<div class="card">
  <h2>Order Saya (Customer)</h2>
  <table class="table">
    <tr><th>ID</th><th>Layanan</th><th>Status</th><th>Total</th><th>Aksi</th></tr>
    <% list.forEach(o => { %>
      <tr>
        <td>#<%= o.id %></td>
        <td><%= o.service_name %></td>
        <td><%= o.status %></td>
        <td><%= formatCurrency(o.total) %></td>
        <td><a class="btn" href="/orders/<%= o.id %>">Detail</a></td>
      </tr>
    <% }) %>
  </table>
</div>
<%- include('../partials/footer') %>
