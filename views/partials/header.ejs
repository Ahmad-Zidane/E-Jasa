<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'eJasa' %> · eJasa</title>
  <link rel="stylesheet" href="/public/css/styles.css">
</head>
<body>
<header>
  <div class="brand"><a href="/" style="color:#fff;">eJasa</a></div>
  <nav>
    <a href="/marketplace?category=onsite">Marketplace On-site</a>
    <a href="/marketplace?category=digital">Marketplace Digital</a>
    <% var u = (typeof currentUser !== 'undefined' && currentUser) ? currentUser : null; %>
    <% if (u && u.role && u.role.startsWith('worker')) { %>
      <a href="/workers/me">Profil Worker</a>
      <a href="/orders">Order Saya</a>
    <% } else if (u && u.role === 'customer') { %>
      <a href="/orders">Order Saya</a>
    <% } %>
    <% if (u && u.role === 'admin') { %>
      <a href="/admin">Admin</a>
    <% } %>
    <% if (!u) { %>
      <a href="/auth/login">Login</a>
      <a href="/auth/register">Register</a>
    <% } else { %>
      <span class="badge">Hi, <%= u.name %> (<%= u.role %>)</span>
      <a href="/auth/logout">Logout</a>
    <% } %>
  </nav>
</header>
<div class="container">
